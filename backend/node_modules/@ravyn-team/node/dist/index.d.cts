import { S as Sdk } from './sdk-Do1IS9bi.cjs';
import 'winston-transport';

interface MetricsOptions {
    /**
     * Export runtime metrics (event-loop lag, CPU, memory).
     * @default true
     */
    enabled?: boolean;
    /** Time in milliseconds between metric exports. */
    intervalMs?: number;
}

interface SamplingOptions {
    /**
     * Fraction of traces to sample, between 0 and 1.
     * @default 1
     */
    traces?: number;
    /**
     * Fraction of logs and errors to sample, between 0 and 1.
     * @default 1
     */
    rate?: number;
}

interface TracingOptions {
    /**
     * Capture distributed traces via OpenTelemetry auto-instrumentation.
     * @default true
     */
    enabled?: boolean;
}

interface RetryOptions {
    /**
     * Initial backoff in milliseconds before the first retry.
     * @default 250
     */
    baseDelayMs?: number;
    /**
     * Maximum backoff in milliseconds between retries.
     * @default 30000
     */
    maxDelayMs?: number;
    /**
     * Maximum delivery attempts before an event is dropped.
     * @default 5
     */
    maxAttempts?: number;
}

interface BreakerOptions {
    /**
     * Consecutive failures before the circuit opens and deliveries pause.
     * @default 5
     */
    failureThreshold?: number;
    /**
     * Time in milliseconds the circuit stays open before retrying.
     * @default 60000
     */
    cooldownMs?: number;
}

interface TransportOptions {
    /**
     * Maximum events per batch. A batch is flushed as soon as this many events
     * are queued, whichever comes first with `flushIntervalMs`.
     * @default 100
     */
    maxBatchSize?: number;
    /**
     * Time in milliseconds before a non-empty batch is flushed, whichever comes
     * first with `maxBatchSize`.
     * @default 5000
     */
    flushIntervalMs?: number;
    /**
     * Maximum events held in memory. Oldest events are dropped on overflow.
     * @default 10000
     */
    maxQueueSize?: number;
    /**
     * Time in milliseconds allowed for the final flush during shutdown.
     * @default 5000
     */
    shutdownTimeoutMs?: number;
    /** Retry tuning for failed deliveries. */
    retry?: RetryOptions;
    /** Circuit-breaker tuning for the exporter. */
    breaker?: BreakerOptions;
}

interface PiiOptions {
    /** Extra field names to redact, added to the built-in defaults. */
    fields?: string[];
    /**
     * Whether to redact the built-in default field set (passwords, tokens,
     * cookies, etc.) in addition to `fields`. Set false to redact only `fields`.
     * @default true
     */
    redactDefaults?: boolean;
}

interface SdkOptions {
    /** Ravyn ingestion endpoint, as a data source name. Required. */
    dsn: string;
    /**
     * Service name attached to every telemetry event.
     * @default "unknown-service"
     */
    service?: string;
    /**
     * Deployment environment (e.g. "production", "staging").
     * @default "production"
     */
    environment?: string;
    /** Release identifier (e.g. version or commit sha) attached to events. */
    release?: string;
    /**
     * Master switch. When false, `init()` returns undefined and nothing starts.
     * @default true
     */
    enabled?: boolean;
    /**
     * Emit internal SDK diagnostics to the console.
     * @default false
     */
    debug?: boolean;
    /** Batching, queueing, retry, and circuit-breaker tuning. */
    transport?: TransportOptions;
    /** Sampling rates for logs/errors and traces. */
    sampling?: SamplingOptions;
    /** Distributed tracing toggle. */
    tracing?: TracingOptions;
    /** Metrics export tuning. */
    metrics?: MetricsOptions;
    /** PII redaction configuration. */
    pii?: PiiOptions;
}

/**
 * Initializes the SDK and starts capturing telemetry. Call once at startup.
 *
 * Safe to call more than once: the first instance is returned on every call.
 * Returns undefined when `options.enabled` is false. Invalid config throws.
 *
 * @param options - Configuration. Only `dsn` is required; all else has defaults.
 * @returns The running SDK instance, or undefined when disabled.
 */
declare function init(options: SdkOptions): Sdk | undefined;
declare function captureException(error: unknown): void;
declare function flush(): Promise<void>;
declare function shutdown(): Promise<void>;

export { type SdkOptions, captureException, flush, init, shutdown };
