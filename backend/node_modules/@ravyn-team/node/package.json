{
  "name": "@ravyn-team/node",
  "version": "0.1.2",
  "description": "Ravyn Node.js SDK — ships logs, errors, traces & metrics to Ravyn without ever crashing your app.",
  "license": "MIT",
  "keywords": [
    "observability",
    "telemetry",
    "opentelemetry",
    "tracing",
    "logging",
    "metrics",
    "error-tracking",
    "ravyn"
  ],
  "homepage": "https://github.com/PentaStack/ravyn-node#readme",
  "bugs": {
    "url": "https://github.com/PentaStack/ravyn-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PentaStack/ravyn-node.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/integrations/express/index.d.ts",
        "default": "./dist/integrations/express/index.js"
      },
      "require": {
        "types": "./dist/integrations/express/index.d.cts",
        "default": "./dist/integrations/express/index.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/integrations/nestjs/index.d.ts",
        "default": "./dist/integrations/nestjs/index.js"
      },
      "require": {
        "types": "./dist/integrations/nestjs/index.d.cts",
        "default": "./dist/integrations/nestjs/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "npm run build && node sample-app/index.cjs",
    "collector": "npx tsx sample-app/collector.ts",
    "trace-demo": "npm run build && node scripts/trace-demo.cjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "express": ">=4.0.0",
    "pino": "*",
    "reflect-metadata": ">=0.1.0",
    "rxjs": ">=7.0.0",
    "winston": "*",
    "winston-transport": "*"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "winston": {
      "optional": true
    },
    "winston-transport": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.0",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "pino": "^9.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.5",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "winston": "^3.0.0",
    "winston-transport": "^4.9.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/context-async-hooks": "^2.8.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1"
  }
}
